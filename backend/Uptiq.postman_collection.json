{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Uptiq — Uptime Monitor API",
    "description": "Complete API collection for Uptiq, a scalable website monitoring platform.\n\n**Base URL:** `{{base_url}}` (default: http://localhost:6969)\n\n**Auth:** After calling `Sign In`, the JWT is automatically saved to the `{{jwt_token}}` collection variable and used by all protected routes via the `Authorization` header.\n\n### Quick Start\n1. Run **Sign Up** to create an account.\n2. Run **Sign In** — the token is auto-saved.\n3. Use any **Websites** endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:6969",
      "type": "string",
      "description": "Base URL of the Uptiq API server."
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string",
      "description": "JWT token — automatically populated after a successful Sign In."
    },
    {
      "key": "website_id",
      "value": "",
      "type": "string",
      "description": "ID of a website resource — automatically populated after Create Website."
    }
  ],
