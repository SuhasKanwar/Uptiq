    {
      "name": "Websites",
      "description": "CRUD operations for monitored websites.\n\nAll endpoints require a valid JWT in the `Authorization` header (`Bearer <token>`). The `{{jwt_token}}` variable is populated automatically after **Sign In**.",
      "item": [
        {
          "name": "Create Website",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('website_id', json.id);",
                  "    console.log('Website id saved:', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "url": {
              "raw": "{{base_url}}/websites",
              "host": ["{{base_url}}"],
              "path": ["websites"]
            },
            "description": "Add a new website to the monitoring list.\n\nThe website is automatically associated with the authenticated user.\n\n**On success:** The new website's `id` is saved to `{{website_id}}` for use in subsequent requests."
          },
          "response": [
            {
              "name": "200 — Created",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"url\": \"https://example.com\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/websites",
                  "host": ["{{base_url}}"],
                  "path": ["websites"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"SUCCESS\",\n  \"id\": \"7f3a1c2e-4b5d-6e7f-8a9b-0c1d2e3f4a5b\"\n}"
            },
            {
              "name": "401 — Unauthorized",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"url\": \"https://example.com\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/websites",
                  "host": ["{{base_url}}"],
                  "path": ["websites"]
                }
              },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "plain",
              "header": [],
              "body": "Missing authorization header"
